{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Copyright 2026 The Khronos Group Inc. SPDX-License-Identifier: Apache-2.0",
  "title": "KHR_materials_procedural whole-document overlay",
  "description": "Apply alongside the core glTF 2.0 schema. Semantic reference, library signature, graph type, and cycle validation is also required. Required identifiers must also be a subset of extensionsUsed; this cross-array constraint is validated semantically.",
  "type": "object",
  "properties": {
    "extensionsUsed": {
      "type": "array",
      "items": {
        "type": "string",
        "not": {
          "allOf": [
            {
              "pattern": "^EXT_materials_procedural_mx_"
            },
            {
              "not": {
                "const": "EXT_materials_procedural_mx_1_39"
              }
            }
          ]
        }
      },
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "const": "KHR_materials_procedural"
          }
        },
        {
          "contains": {
            "const": "EXT_materials_procedural_mx_1_39"
          }
        }
      ]
    },
    "extensionsRequired": {
      "type": "array",
      "items": {
        "type": "string",
        "not": {
          "allOf": [
            {
              "pattern": "^EXT_materials_procedural_mx_"
            },
            {
              "not": {
                "const": "EXT_materials_procedural_mx_1_39"
              }
            }
          ]
        }
      },
      "uniqueItems": true,
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "contains": {
                  "const": "KHR_materials_procedural"
                }
              },
              {
                "contains": {
                  "const": "EXT_materials_procedural_mx_1_39"
                }
              }
            ]
          },
          "then": {
            "allOf": [
              {
                "contains": {
                  "const": "KHR_materials_procedural"
                }
              },
              {
                "contains": {
                  "const": "EXT_materials_procedural_mx_1_39"
                }
              }
            ]
          }
        }
      ]
    },
    "extensions": {
      "type": "object",
      "properties": {
        "KHR_materials_procedural": {
          "$ref": "glTF.KHR_materials_procedural.schema.json"
        }
      },
      "required": [
        "KHR_materials_procedural"
      ],
      "not": {
        "required": [
          "EXT_materials_procedural_mx_1_39"
        ]
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "extensions": {
            "type": "object",
            "properties": {
              "KHR_materials_procedural": {
                "$ref": "material.KHR_materials_procedural.schema.json"
              }
            },
            "not": {
              "required": [
                "EXT_materials_procedural_mx_1_39"
              ]
            }
          },
          "pbrMetallicRoughness": {
            "type": "object",
            "properties": {
              "baseColorTexture": {
                "type": "object",
                "properties": {
                  "extensions": {
                    "type": "object",
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "KHR_materials_procedural"
                          ]
                        },
                        {
                          "required": [
                            "EXT_materials_procedural_mx_1_39"
                          ]
                        }
                      ]
                    }
                  }
                }
              },
              "metallicRoughnessTexture": {
                "type": "object",
                "properties": {
                  "extensions": {
                    "type": "object",
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "KHR_materials_procedural"
                          ]
                        },
                        {
                          "required": [
                            "EXT_materials_procedural_mx_1_39"
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "normalTexture": {
            "type": "object",
            "properties": {
              "extensions": {
                "type": "object",
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "KHR_materials_procedural"
                      ]
                    },
                    {
                      "required": [
                        "EXT_materials_procedural_mx_1_39"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "occlusionTexture": {
            "type": "object",
            "properties": {
              "extensions": {
                "type": "object",
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "KHR_materials_procedural"
                      ]
                    },
                    {
                      "required": [
                        "EXT_materials_procedural_mx_1_39"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "emissiveTexture": {
            "type": "object",
            "properties": {
              "extensions": {
                "type": "object",
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "KHR_materials_procedural"
                      ]
                    },
                    {
                      "required": [
                        "EXT_materials_procedural_mx_1_39"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "extensions"
              ],
              "properties": {
                "extensions": {
                  "required": [
                    "KHR_materials_unlit",
                    "KHR_materials_procedural"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "extensions": {
                  "properties": {
                    "KHR_materials_procedural": {
                      "properties": {
                        "bindings": {
                          "propertyNames": {
                            "enum": [
                              "baseColor",
                              "opacity"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "textures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "extensions": {
            "type": "object",
            "not": {
              "anyOf": [
                {
                  "required": [
                    "KHR_materials_procedural"
                  ]
                },
                {
                  "required": [
                    "EXT_materials_procedural_mx_1_39"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "extensions": {
            "type": "object",
            "not": {
              "anyOf": [
                {
                  "required": [
                    "KHR_materials_procedural"
                  ]
                },
                {
                  "required": [
                    "EXT_materials_procedural_mx_1_39"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  },
  "required": [
    "extensionsUsed",
    "extensions"
  ],
  "definitions": {
    "noCompanionPayload": {
      "if": {
        "type": "object"
      },
      "then": {
        "properties": {
          "extensions": {
            "if": {
              "type": "object"
            },
            "then": {
              "not": {
                "required": [
                  "EXT_materials_procedural_mx_1_39"
                ]
              }
            },
            "allOf": [
              {
                "$ref": "#/definitions/noCompanionPayload"
              }
            ]
          }
        },
        "additionalProperties": {
          "$ref": "#/definitions/noCompanionPayload"
        }
      },
      "else": {
        "if": {
          "type": "array"
        },
        "then": {
          "items": {
            "$ref": "#/definitions/noCompanionPayload"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/noCompanionPayload"
    }
  ]
}
